# Care Agent v5 — environment
#
# Everything here is optional. The backend starts with none of it set:
# unconfigured model slots fall back to the offline stubs so the cascade
# can be exercised end to end before a single key exists (v5 04).
#
# Secrets are better set in Setup, which stores them 0600 under data/ and
# never returns them over the API. These variables are the Docker/CI path.
# Copy to `.env` and load it yourself — the backend does not read `.env`,
# it reads the process environment and its own secret store.

# --- Secrets -----------------------------------------------------------
GEMINI_API_KEY=
MINIMAX_API_KEY=
RTSP_PASSWORD=
TELEGRAM_BOT_TOKEN=

# --- L2 · Gemini (Google native REST, not OpenAI-compatible) -----------
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SEC=45

# --- L3 · MiniMax (OpenAI-compatible) ----------------------------------
MINIMAX_MODEL=MiniMaxAI/MiniMax-M3
MINIMAX_BASE_URL=https://api.gmi-serving.com/v1
MINIMAX_TIMEOUT_SEC=90

# --- Host-managed (not editable from the browser) ----------------------
CARE_HOST=127.0.0.1
CARE_PORT=8000
CARE_SUBJECT_ID=subject-1
# CARE_DATA_DIR=/var/lib/care-agent
# CARE_DB_PATH=/var/lib/care-agent/care.sqlite3

# --- Tooling -----------------------------------------------------------
# CARE_PYTHON=python3.12
# FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY=ffprobe
