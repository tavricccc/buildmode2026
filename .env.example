APP_ENV=development
DEMO_MODE=replay
ACTIVE_SOURCE=replay
DATABASE_PATH=data/care_agent.db
MEDIA_ROOT=data/media
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8002
# For LAN access, use BIND_HOST=0.0.0.0 and keep firewall profile Private.
BIND_HOST=127.0.0.1
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
HTTPS=false
HTTPS_CERT_FILE=certs/lan.crt
HTTPS_KEY_FILE=certs/lan.key

# local runtime is intentionally explicit; stub keeps this Windows checkout runnable.
LOCAL_VLM_MODE=vllm
LOCAL_VLM_MODEL=nemotron_omni
LOCAL_VLM_QUANTIZATION=4bit
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=nemotron_omni
VLLM_API_KEY=
FLOW_MODEL_PROVIDER=local_vlm
FLOW_MODEL_BASE_URL=
FLOW_MODEL_ID=
FLOW_MODEL_API_KEY_FILE=
VLLM_SAMPLE_FPS=2.0
VLLM_WINDOW_SECONDS=5.0
VLLM_WINDOW_STRIDE_SECONDS=5.0
VLLM_WINDOW_FRAMES=10
VLLM_MAX_FRAME_WIDTH=1280
VLLM_MAX_CONCURRENCY=12
VLLM_MAX_PENDING_WINDOWS=48
# Baseline observation heartbeat. The change gate accelerates observation, it
# does not filter it: a motionless person on the floor produces no pixel
# change, so an unchanged window is still observed every N seconds (and always
# while a fall or hydration event is open). 0 disables the heartbeat; open
# events are still forced.
OBSERVATION_HEARTBEAT_SECONDS=0
OBSERVATION_QUIET_SECONDS=30
OBSERVATION_QUIET_SAMPLE_INTERVAL_SECONDS=3
OBSERVATION_QUIET_FRAMES=10
CHANGE_GATE_THRESHOLD=0.06
CHANGE_GATE_AUDIO_DELTA_THRESHOLD=0.06
CHANGE_GATE_MIN_CHANGED_PAIRS=2
CHANGE_GATE_STRONG_SCORE_MULTIPLIER=2.5
# Vision wire format: `frames` (verified: 10 base64 JPEG parts + one WAV part)
# or `video` (one base64 video_url part). The hosted provider does not document
# a video_url format, so run the capability probe before switching.
VISION_WIRE_FORMAT=frames
VISION_VIDEO_CRF=28
VISION_VIDEO_MAX_WIDTH=768
VISION_VIDEO_ENCODE_TIMEOUT=20
VLLM_OBSERVATION_ENABLE_THINKING=false
VLLM_MAIN_AGENT_ENABLE_THINKING=false
VIDEO_RETENTION_SECONDS=60
DETAIL_SAMPLE_FPS=5.0
DETAIL_WINDOW_SECONDS=2.0
DETAIL_WINDOW_FRAMES=10
DETAIL_WINDOW_STRIDE_SECONDS=1.0
DETAIL_ACTIVE_SECONDS=10.0
DETAIL_MAX_PENDING=2
FOCUS_WINDOW_SECONDS=10.0
FOCUS_WINDOW_FRAMES=20
MAIN_AGENT_ENABLED=true
MAIN_AGENT_MAX_PENDING=6
MAIN_AGENT_INTERVAL_SECONDS=20
AGENT_SUMMARY_INTERVAL_SECONDS=600
AGENT_HOURLY_SUMMARY_INTERVAL_SECONDS=3600
MAIN_AGENT_MIN_CONFIDENCE=0.55
WHISPER_MODEL=small

# Optional OpenAI-compatible MiniMax endpoint. Never commit a real key.
MINIMAX_BASE_URL=https://api.gmi-serving.com
MINIMAX_MODEL=MiniMaxAI/MiniMax-M3
MINIMAX_API_KEY=
MINIMAX_API_KEY_FILE=
MINIMAX_TTS_BASE_URL=https://api.minimax.io/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE_ID=Chinese (Mandarin)_Warm_Bestie
MINIMAX_TTS_API_KEY=
MINIMAX_TTS_API_KEY_FILE=
# Browser Web Speech API is the temporary local, non-model TTS path.
LOCAL_TTS_ENABLED=true
LOCAL_TTS_LANGUAGE=zh-TW
LOCAL_TTS_RATE=0.95
TTS_RETENTION_MINUTES=60
RESIDENT_UNDERSTANDING_INTERVAL_SECONDS=300
RESIDENT_PROACTIVE_SPEECH_ENABLED=false
RESIDENT_PROACTIVE_COOLDOWN_MINUTES=30
RESIDENT_PROACTIVE_INTERVAL_SECONDS=1800
RESIDENT_PROACTIVE_ALIGN_TO_HOUR=false
RESIDENT_DISPLAY_NAME=阿嬤
HIGH_RISK_REPEAT_QUESTION_SECONDS=20
HIGH_RISK_NO_RESPONSE_SECONDS=60

# Optional Telegram L3 channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_TIMEOUT_SEC=20

# Optional HTTP frame bridge. Standard Frigate normally ingests RTSP and emits MQTT events.
FRIGATE_BASE_URL=http://127.0.0.1:5000
FRIGATE_FRAME_ENDPOINT=
FRIGATE_NOTEWORTHY_LABELS=fall,fire,smoke
FRIGATE_NOTEWORTHY_ZONES=living
# Optional: backend pipes the browser WebM stream through ffmpeg to this go2rtc/Frigate RTSP publish URL.
FRIGATE_RTSP_PUBLISH_URL=rtsp://127.0.0.1:8554/browser-camera
VIRTUAL_CAMERA_ENABLED=true
FRIGATE_MQTT_HOST=127.0.0.1
FRIGATE_MQTT_PORT=1883
FRIGATE_MQTT_TOPIC=frigate/events
FRIGATE_MQTT_USERNAME=
FRIGATE_MQTT_PASSWORD=
